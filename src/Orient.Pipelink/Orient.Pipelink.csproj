<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Orient.Pipelink</RootNamespace>
    <PackageId>Orient.Pipelink</PackageId>
    <Title>Orient.Pipelink</Title>
    <Description>Lightweight, free mediator for .NET: requests, notifications, streams and opt-in pipeline behaviors with DI-scoped handlers. Pipelink, now part of the Orient family.</Description>
    <PackageTags>orient;pipelink;mediator;cqrs;request;notification;stream;pipeline</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
