<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Orient.MediatR</RootNamespace>
    <PackageId>Orient.MediatR</PackageId>
    <Title>Orient.MediatR</Title>
    <Description>Lightweight, free mediator for .NET: requests, notifications, streams and opt-in pipeline behaviors with DI-scoped handlers. Part of the Orient family.</Description>
    <PackageTags>orient;mediator;cqrs;mediatr;request;notification;stream;pipeline</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
